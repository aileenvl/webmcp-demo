{
  "name": "webmcp-agenda-jsconfmx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Demo educativo local de WebMCP para JSConfMX, en español",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "check": "npm test && npm run build",
    "taller:copiar": "node scripts/taller.mjs copiar",
    "taller:diff": "node scripts/taller.mjs diff",
    "publicar:next": "npm run build && node scripts/publicar-next.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "webmcp-types": "0.1.10"
  }
}
